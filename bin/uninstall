#!/usr/bin/env bash
# Remove the plugin, its hook and the system bits bin/install added.
#
# The tiny-dfr package itself is left alone. A git-managed plugin directory is
# left alone too: remove that with `omarchy plugin remove ewweberlin.touchbar`.
set -euo pipefail
cd -- "$(dirname -- "$0")/.."

REPO=$(pwd -P)
PLUGIN_ID="ewweberlin.touchbar"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
PLUGINS_DIR="${OMARCHY_PLUGINS_DIR:-$CONFIG_HOME/omarchy/plugins}"
PLUGIN_DIR="$PLUGINS_DIR/$PLUGIN_ID"
HOOKS_DIR="${OMARCHY_HOOKS_DIR:-$CONFIG_HOME/omarchy/hooks}/theme-set.d"
SHELL_JSON="${OMARCHY_SHELL_JSON:-$CONFIG_HOME/omarchy/shell.json}"
UDEV_RULE=/etc/udev/rules.d/90-omarchy-touchbar.rules
TINY_DFR_DIR=/etc/tiny-dfr
TINY_DFR_CONFIG="$TINY_DFR_DIR/config.toml"
TINY_DFR_SVG="$TINY_DFR_DIR/omarchy-touchbar.svg"
MARKER="# Generated by ewweberlin.touchbar."
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-touchbar"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-touchbar"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-touchbar"

DRY_RUN=0
SYSTEM=1
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --no-system) SYSTEM=0 ;;
    -h | --help)
      cat <<'EOF'
Usage: bin/uninstall [--dry-run] [--no-system]

  --dry-run    print what would change, touch nothing
  --no-system  leave /etc/udev and /etc/tiny-dfr alone
EOF
      exit 0
      ;;
    *)
      echo "uninstall: unknown option: $arg" >&2
      exit 2
      ;;
  esac
done

say() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }

run() {
  if ((DRY_RUN)); then
    printf '+ '
    printf '%q ' "$@"
    printf '\n'
  else
    "$@"
  fi
}

as_root() {
  if ((DRY_RUN)); then
    printf '+ sudo '
    printf '%q ' "$@"
    printf '\n'
  else
    sudo "$@"
  fi
}

# ------------------------------------------------------------------- plugin --
say "removing the plugin"
if [[ -L "$PLUGIN_DIR" ]]; then
  if [[ $(readlink -f "$PLUGIN_DIR") == "$REPO" ]]; then
    run rm -f "$PLUGIN_DIR"
  else
    warn "$PLUGIN_DIR points somewhere else; leaving it alone"
  fi
elif [[ -d "$PLUGIN_DIR" ]]; then
  installed_id=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("id", ""))' \
    "$PLUGIN_DIR/manifest.json" 2>/dev/null || true)
  if [[ -d "$PLUGIN_DIR/.git" ]]; then
    warn "$PLUGIN_DIR is a git checkout; remove it with:"
    warn "    omarchy plugin remove $PLUGIN_ID"
  elif [[ $installed_id == "$PLUGIN_ID" ]]; then
    run rm -rf "$PLUGIN_DIR"
  else
    warn "$PLUGIN_DIR is not $PLUGIN_ID; leaving it alone"
  fi
fi

say "removing the theme hook"
HOOK_DST="$HOOKS_DIR/10-omarchy-touchbar"
if [[ -L "$HOOK_DST" ]]; then
  if [[ $(readlink -f "$HOOK_DST") == "$REPO/hooks/10-omarchy-touchbar" ]]; then
    run rm -f "$HOOK_DST"
  else
    warn "the theme hook points somewhere else; leaving it alone"
  fi
elif [[ -e "$HOOK_DST" ]]; then
  if grep -qF 'ewweberlin.touchbar' "$HOOK_DST"; then
    run rm -f "$HOOK_DST"
  else
    warn "$HOOK_DST is not ours; leaving it alone"
  fi
fi

say "removing the shell.json entry"
if ((DRY_RUN)); then
  printf '+ python3 - %q %q  # drop the plugins[] entry\n' "$SHELL_JSON" "$PLUGIN_ID"
elif [[ -f $SHELL_JSON ]]; then
  python3 - "$SHELL_JSON" "$PLUGIN_ID" <<'PY'
import json
import os
import sys
import time

path, plugin_id = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
except (OSError, ValueError) as exc:
    sys.exit(f"{path}: {exc}")

plugins = data.get("plugins") if isinstance(data, dict) else None
if not isinstance(plugins, list):
    sys.exit(0)

kept = [
    entry for entry in plugins
    if not (isinstance(entry, dict) and entry.get("id") == plugin_id)
]
if len(kept) == len(plugins):
    sys.exit(0)

data["plugins"] = kept
backup = f"{path}.bak.{int(time.time())}"
with open(path, encoding="utf-8") as handle:
    original = handle.read()
mode = os.stat(path).st_mode & 0o777
with open(backup, "w", encoding="utf-8") as handle:
    handle.write(original)
tmp = f"{path}.tmp.{os.getpid()}"
with open(tmp, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2)
    handle.write("\n")
os.chmod(tmp, mode)
os.replace(tmp, path)
print(f"disabled {plugin_id} in {path} (backup: {backup})")
PY
fi

# -------------------------------------------------------------------- state --
say "clearing runtime state"
for path in "$RUNTIME_DIR" "$STATE_DIR" "$CACHE_DIR"; do
  if [[ -e $path ]]; then
    run rm -rf "$path"
  fi
done
warn "keeping $CONFIG_HOME/omarchy-touchbar/config.json"
warn "(delete it yourself if you want a clean reinstall)"

# ------------------------------------------------------------------- system --
if ((SYSTEM)); then
  say "removing system permissions and the udev rule"
  if ((DRY_RUN)); then
    as_root true
  elif ! sudo -v; then
    warn "sudo is unavailable; skipping system changes (re-run with --no-system)"
    SYSTEM=0
  fi
fi

if ((SYSTEM)) && [[ -e $UDEV_RULE ]]; then
  as_root rm -f "$UDEV_RULE"
  as_root udevadm control --reload-rules
  as_root udevadm trigger --subsystem-match=input
fi

if ((SYSTEM)); then
  if [[ -e $TINY_DFR_SVG ]]; then
    as_root rm -f "$TINY_DFR_SVG"
  fi
  # Only remove a config this plugin generated. A user-written or package
  # config stays put; tiny-dfr would fall back to the base config otherwise.
  if [[ -f $TINY_DFR_CONFIG ]] && grep -qxF "$MARKER" "$TINY_DFR_CONFIG"; then
    as_root rm -f "$TINY_DFR_CONFIG"
  fi
fi

cat <<EOF

Removed $PLUGIN_ID.
Restart the shell so the service stops:
  omarchy restart shell

The tiny-dfr package and /usr/share/tiny-dfr are untouched.
EOF
